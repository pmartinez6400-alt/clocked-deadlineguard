# DeadlineGuard configuration. Copy to .env and fill in, or export the
# variables in your shell. The server also reads a plain .env file.

# Your Clocked API key (create one on your account page at
# https://clocked.rezolve.ai). When set, the live Clocked adapter is used.
# When empty, DeadlineGuard runs on the built-in mock adapter so the whole
# app works offline with zero credits spent.
CLOCKED_API_KEY=

# Clocked API base URL (the official default is shown; override only for
# testing).
CLOCKED_BASE_URL=https://clocked.rezolve.ai/clocked

# Force an adapter: auto (default) | live | mock.
CLOCKED_ADAPTER=auto

# Port for the web app.
PORT=4317
